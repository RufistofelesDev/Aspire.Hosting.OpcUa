<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHostingSDK>true</IsAspireHostingSDK>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Rufistofeles.Aspire.Hosting.OpcUa</PackageId>
    <Version>1.0.0</Version>
    <Description>An Aspire hosting integration for OPC UA. Adds a fully simulated industrial PLC to your app model with one line — no hardware required.</Description>
    <PackageReleaseNotes>First stable release. Verified end to end against a running container, not only against the resource model: the pinned image pulls, Aspire starts it, every argument the package emits is accepted and acted on by the simulator, the OPC UA endpoint completes a protocol handshake, and the HTTP endpoint serves the OPC Publisher configuration. Fixes a defect found by that first real run — the HTTP endpoint was advertised but never listening, because --wp selects the port while only --sp starts the web server.</PackageReleaseNotes>
    <PackageTags>aspire;opcua;opc-ua;iiot;industrial;plc;scada;automation;dotnet</PackageTags>
    <Authors>Rafael Pérez</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/RufistofelesDev/Aspire.Hosting.OpcUa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RufistofelesDev/Aspire.Hosting.OpcUa</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
