<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHostingSDK>true</IsAspireHostingSDK>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Rufistofeles.Aspire.Hosting.OpcUa</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Description>An Aspire hosting integration for OPC UA. Adds a fully simulated industrial PLC to your app model with one line — no hardware required.</Description>
    <PackageReleaseNotes>Preview. The resource model, container image reference (mcr.microsoft.com/iotedge/opc-plc:2.14.22) and every simulator argument are unit-tested and verified against the simulator's documented options, but the container has not yet been started end-to-end under an Aspire AppHost. 1.0.0 ships once it has.</PackageReleaseNotes>
    <PackageTags>aspire;opcua;opc-ua;iiot;industrial;plc;scada;automation;dotnet</PackageTags>
    <Authors>Rafael Pérez</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/RufistofelesDev/Aspire.Hosting.OpcUa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RufistofelesDev/Aspire.Hosting.OpcUa</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
